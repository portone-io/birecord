{
  "name": "birecord",
  "version": "0.1.1",
  "description": "Bi-directional record in type-safe way",
  "main": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/mod.d.mts",
        "default": "./dist/mod.mjs"
      },
      "require": {
        "types": "./dist/mod.d.ts",
        "default": "./dist/mod.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE-*"
  ],
  "scripts": {
    "build": "tsup ./mod.ts --dts --format esm,cjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "ci:publish": "pnpm publish -r && changeset tag"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/portone-io/birecord.git"
  },
  "keywords": [
    "birecord",
    "bimap",
    "bidirectional"
  ],
  "author": "JongChan Choi <rieul@portone.io>",
  "license": "(MIT OR Apache-2.0)",
  "bugs": {
    "url": "https://github.com/portone-io/birecord/issues"
  },
  "homepage": "https://github.com/portone-io/birecord#readme",
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "tsup": "^7.2.0",
    "typescript": "^5.1.6"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8"
}
